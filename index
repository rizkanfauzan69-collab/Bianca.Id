        window.renderKasbonList = function() {
            const listContainer = document.getElementById('kasbon-modal-list');
            const selectEl = document.getElementById('filter-kasbon-project');
            const selectedProject = selectEl ? selectEl.value.toLowerCase() : "";
            
            let html = '';
            let globalSisa = 0;

            if (!selectedProject) {
                listContainer.innerHTML = '<p class="text-[10px] text-cream/50 text-center py-4">Silakan pilih project terlebih dahulu.</p>';
                document.getElementById('total-sisa-kasbon-global').innerText = 'Rp 0';
                return;
            }

            if (state.workers.length === 0) {
                listContainer.innerHTML = '<p class="text-[10px] text-cream/50 text-center py-4">Belum ada data tukang.</p>';
                document.getElementById('total-sisa-kasbon-global').innerText = 'Rp 0';
                return;
            }

            const kasbonData = [];

            state.workers.forEach(w => {
                let totalKasbonTx = 0; 
                let totalKasbonUsed = 0;

                state.transactions.forEach(t => {
                    if(t.type === 'pengeluaran' && (t.category || '').toLowerCase() === 'kasbon') {
                        if(t.project && t.project.toLowerCase() === selectedProject) {
                            if(t.worker && w.nama.toLowerCase() === t.worker.toLowerCase()) { 
                                totalKasbonTx += parseFloat(t.amount) || 0; 
                            }
                        }
                    }
                });

                state.payrolls.forEach(p => { 
                    if(p.workerId === w.id && p.project && p.project.toLowerCase() === selectedProject) { 
                        totalKasbonUsed += parseFloat(p.kasbon) || 0; 
                    }
                });

                const sisaKasbon = Math.max(0, totalKasbonTx - totalKasbonUsed);
                
                if (totalKasbonTx > 0 || totalKasbonUsed > 0 || sisaKasbon > 0) {
                    globalSisa += sisaKasbon;
                    kasbonData.push({
                        name: w.nama,
                        jabatan: w.jabatan,
                        diambil: totalKasbonTx,
                        dibayar: totalKasbonUsed,
                        sisa: sisaKasbon
                    });
                }
            });

            kasbonData.sort((a, b) => b.sisa - a.sisa);

            if(kasbonData.length === 0) {
                 html = `<p class="text-[10px] text-cream/50 text-center py-4">Tidak ada data kasbon di project ini.</p>`;
            } else {
                kasbonData.forEach(data => {
                    const hasSisa = data.sisa > 0;
                    html += `
                    <div class="p-3 bg-choc-800 rounded-xl border border-gold-500/10 shadow-sm space-y-2">
                        <div class="flex justify-between items-center border-b border-gold-500/10 pb-2">
                            <span class="font-bold text-cream text-[11px]">${data.name} <span class="text-[9px] text-gold-400 font-normal">(${data.jabatan})</span></span>
                            <span class="font-bold text-xs ${hasSisa ? 'text-rose-400' : 'text-emerald-400'}">${formatRp(data.sisa)}</span>
                        </div>
                        <div class="flex justify-between text-[9px] pt-0.5">
                            <div class="flex flex-col">
                                <span class="text-cream/50">Total Pinjaman</span>
                                <strong class="text-gold-300 mt-1">${formatRp(data.diambil)}</strong>
                            </div>
                            <div class="flex flex-col text-right">
                                <span class="text-cream/50">Telah Terpotong Gaji</span>
                                <strong class="text-emerald-400 mt-1">${formatRp(data.dibayar)}</strong>
                            </div>
                        </div>
                    </div>
                    `;
                });
            }

            listContainer.innerHTML = html;
            document.getElementById('total-sisa-kasbon-global').innerText = formatRp(globalSisa);
        };

