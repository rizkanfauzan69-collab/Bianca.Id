        window.renderAttendanceHistoryList = function() {
            const filterProj = document.getElementById('filter-abs-project').value.toLowerCase();
            const startStr = document.getElementById('abs-hist-start').value;
            const endStr = document.getElementById('abs-hist-end').value;
            
            const list = document.getElementById('attendance-modal-list');
            
            let startD = null, endD = null;
            if(startStr && endStr) {
                const sp = startStr.split('-'); const ep = endStr.split('-');
                startD = new Date(parseInt(sp[0]), parseInt(sp[1]) - 1, parseInt(sp[2]), 0, 0, 0);
                endD = new Date(parseInt(ep[0]), parseInt(ep[1]) - 1, parseInt(ep[2]), 23, 59, 59);
            }

            const filtered = state.attendances.filter(a => {
                if (filterProj && a.project.toLowerCase() !== filterProj) return false;
                if (startD && endD) {
                    const aParts = a.date.split('/');
                    if(aParts.length === 3) {
                        const aDate = new Date(parseInt(aParts[2]), parseInt(aParts[1]) - 1, parseInt(aParts[0]), 12, 0, 0);
                        if (aDate < startD || aDate > endD) return false;
                    }
                }
                return true;
            }).reverse();
            
            const workerFilterContainer = document.getElementById('abs-worker-filter');
            if (workerFilterContainer) {
                let uniqueWorkers = {};
