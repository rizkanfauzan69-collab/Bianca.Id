                                    <th style="padding: 8px; text-align: center; border: 1px solid rgba(197, 160, 89, 0.3); width: 50px;">Total<br>Hari</th>
                                    <th style="padding: 8px; text-align: center; border: 1px solid rgba(197, 160, 89, 0.3); width: 60px;">Total<br>Lembur</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${tableRowsHtml}
                            </tbody>
