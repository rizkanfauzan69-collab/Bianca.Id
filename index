<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#120C08">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>BIANCA.ID - Interior Design & Build</title>
    
    <!-- Link Manifest PWA Eksternal -->
    <link rel="manifest" href="manifest.json">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        choc: { 900: '#120C08', 800: '#1A120B', 700: '#271D14', 600: '#3D2C1F', 500: '#5C4033' },
                        gold: { 600: '#997A15', 500: '#C5A059', 400: '#E6C687', 300: '#F4E3BF' },
                        cream: '#FDFBF7'
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    animation: { 'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite' }
                }
            }
        }
    </script>
    
    <style>
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-panel { background: rgba(26, 18, 11, 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        .stagger-1 { animation: slideUpFade 0.6s ease-out 0.1s forwards; opacity: 0; }
        .stagger-2 { animation: slideUpFade 0.6s ease-out 0.2s forwards; opacity: 0; }
        .stagger-3 { animation: slideUpFade 0.6s ease-out 0.3s forwards; opacity: 0; }
        @keyframes slideUpFade { 0% { opacity: 0; transform: translateY(20px); } 100% { opacity: 1; transform: translateY(0); } }
        .animate-slide-up { animation: slideUpFade 0.5s ease-out forwards; }
        .modal-scrollable { max-height: 85vh; overflow-y: auto; -webkit-overflow-scrolling: touch; }
        .rab-row-animate { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        .photo-preview { width: 100%; height: 120px; object-fit: cover; border-radius: 0.5rem; }
    </style>
</head>
<body class="flex flex-col h-[100dvh] overflow-hidden text-sm sm:text-base bg-choc-900 font-sans text-cream relative selection:bg-gold-500/30 selection:text-gold-300">

    <div id="login-screen" class="fixed inset-0 z-[150] bg-choc-900 flex flex-col items-center justify-center p-6 overflow-hidden transition-opacity duration-500">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-radial-gradient from-gold-600/10 to-transparent blur-[80px] animate-pulse-slow pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-64 h-64 bg-gold-500/10 rounded-full blur-[100px] animate-pulse-slow pointer-events-none" style="animation-delay: 1s;"></div>
        
        <div class="glass-panel p-8 rounded-3xl max-w-sm w-full text-center shadow-2xl border border-gold-500/30 relative z-10">
            <h1 class="stagger-1 text-4xl font-extrabold tracking-wider text-gold-500 mb-1 mt-2">BIANCA.ID</h1>
            <p class="stagger-1 text-[10px] tracking-[0.3em] uppercase text-gold-400/70 font-medium mb-1">Interior Design & Build</p>
            <div class="stagger-1 inline-block bg-emerald-900/30 text-emerald-400 border border-emerald-500/30 text-[9px] px-2 py-0.5 rounded-full font-bold mb-8 uppercase tracking-widest"><i class="fas fa-cloud"></i> PWA Cloud Ready</div>
            
            <div class="stagger-2 space-y-4 text-left mb-8">
                <div>
                    <label class="text-xs text-gold-400 font-medium block mb-1">Kata Sandi Akses</label>
                    <input type="password" id="login-password" placeholder="Masukan Kata Sandi" class="w-full bg-choc-800/80 border border-gold-500/30 rounded-xl px-4 py-3.5 text-cream text-sm focus:outline-none focus:border-gold-400 transition-colors shadow-inner">
                </div>
                <button onclick="window.handleLogin()" class="w-full py-4 bg-gradient-to-r from-gold-600 to-gold-400 hover:from-gold-500 hover:to-gold-300 text-choc-900 font-bold rounded-xl shadow-[0_0_15px_rgba(197,160,89,0.3)] transition-all active:scale-95 text-sm uppercase tracking-widest">
                    Akses Ruang Kerja
                </button>
            </div>
            
            <p class="stagger-3 text-[9px] text-gold-300/50 italic uppercase tracking-[0.2em] leading-relaxed border-t border-gold-500/20 pt-6">
                "Data Anda abadi di memori lokal. Aplikasi otomatis diperbarui dari Cloud."
            </p>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div id="main-app" class="flex flex-col h-full max-w-md mx-auto w-full bg-choc-900 shadow-2xl border-x border-choc-800 hidden relative">
        
        <header class="px-5 py-4 bg-choc-900 border-b border-gold-500/20 flex items-center justify-between z-20 shrink-0 shadow-md">
            <div>
                <h1 class="font-extrabold text-xl tracking-wider text-gold-500 leading-none">BIANCA.ID</h1>
                <p class="text-[9px] uppercase tracking-widest text-cream/50 font-medium mt-1">Interior Design & Build</p>
            </div>
            <div class="text-right flex items-center gap-2">
                <div class="flex gap-1 bg-choc-800 p-1 rounded-full border border-gold-500/20">
                    <button onclick="window.undo()" id="btn-undo" disabled class="w-7 h-7 rounded-full flex items-center justify-center text-cream/20 transition-colors active:scale-95"><i class="fas fa-undo text-[10px]"></i></button>
                    <button onclick="window.redo()" id="btn-redo" disabled class="w-7 h-7 rounded-full flex items-center justify-center text-cream/20 transition-colors active:scale-95"><i class="fas fa-redo text-[10px]"></i></button>
                </div>
                <button onclick="window.openSettings()" class="text-[9px] bg-choc-800 border border-gold-500/30 text-gold-400 px-3 py-1.5 rounded-full font-medium flex items-center gap-1.5 hover:bg-choc-700 transition-colors active:scale-95 shadow-sm">
                    <i class="fas fa-cog"></i> Pengaturan
                </button>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto no-scrollbar pt-4 pb-6 px-4 space-y-5 relative">
            
            <section id="page-dashboard" class="space-y-5 animate-slide-up">
                <div class="glass-panel p-4 rounded-2xl relative overflow-hidden bg-gradient-to-br from-choc-800 to-choc-700 border border-gold-500/30 shadow-lg">
                    <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-gold-500/10 rounded-full blur-2xl pointer-events-none"></div>
                    <p class="text-xs font-medium text-gold-400/80 uppercase tracking-wider mb-1">Saldo Kas Perusahaan</p>
                    <h2 id="dash-saldo" class="text-3xl font-extrabold text-cream tracking-tight mb-2">Rp 0</h2>
                    <div class="flex items-center justify-between text-[10px] pt-3 border-t border-gold-500/20">
                        <span class="text-emerald-400 flex items-center gap-1"><i class="fas fa-arrow-up"></i> Total Masuk: <strong id="dash-masuk">Rp 0</strong></span>
                        <span class="text-rose-400 flex items-center gap-1"><i class="fas fa-arrow-down"></i> Total Keluar: <strong id="dash-keluar">Rp 0</strong></span>
                    </div>
                </div>

                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 shadow-lg">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400">Arus Kas Tahunan</h3>
                        <div class="flex items-center gap-1.5">
                            <button onclick="window.changeYear(-1)" class="text-[10px] bg-choc-800 text-gold-400 hover:text-gold-300 px-2 py-1 rounded border border-gold-500/30 transition-colors active:scale-95"><i class="fas fa-chevron-left"></i></button>
                            <span id="chart-year-label" class="text-[10px] bg-choc-800 text-cream/90 px-3 py-1 rounded font-bold border border-gold-500/30 shadow-inner">2026</span>
                            <button onclick="window.changeYear(1)" class="text-[10px] bg-choc-800 text-gold-400 hover:text-gold-300 px-2 py-1 rounded border border-gold-500/30 transition-colors active:scale-95"><i class="fas fa-chevron-right"></i></button>
                        </div>
                    </div>
                    <div class="h-44 w-full"><canvas id="barChart"></canvas></div>
                </div>

                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 shadow-lg">
                    <h3 id="pie-chart-title" class="text-xs font-bold uppercase tracking-wider text-gold-400 mb-3">Distribusi Pengeluaran Tahun Ini</h3>
                    <div class="flex items-center justify-between gap-2">
                        <div class="w-1/2 h-32 relative"><canvas id="pieChart"></canvas></div>
                        <div class="w-1/2 space-y-2 text-[9px]">
                            <div class="flex justify-between border-b border-gold-500/10 pb-1"><span class="text-emerald-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_5px_#10B981]"></span> Margin/Profit</span><strong id="sum-margin">Rp 0</strong></div>
                            <div class="flex justify-between border-b border-gold-500/10 pb-1"><span class="text-rose-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-rose-500 shadow-[0_0_5px_#F43F5E]"></span> Material</span><strong id="sum-mat">Rp 0</strong></div>
                            <div class="flex justify-between border-b border-gold-500/10 pb-1"><span class="text-sky-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-sky-500 shadow-[0_0_5px_#0EA5E9]"></span> Upah/Gaji</span><strong id="sum-upah">Rp 0</strong></div>
                            <div class="flex justify-between"><span class="text-amber-400 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-amber-500 shadow-[0_0_5px_#F59E0B]"></span> Lainnya</span><strong id="sum-ops">Rp 0</strong></div>
                        </div>
                    </div>
                </div>

                <div class="glass-panel p-3 rounded-2xl border border-gold-500/20 shadow-lg">
                    <h3 id="table-rekap-title" class="text-xs font-bold uppercase tracking-wider text-gold-400 mb-2 px-1">Laporan Rinci (Bulan)</h3>
                    <div class="overflow-x-auto no-scrollbar pb-2">
                        <table class="w-full text-[9px] text-left border-collapse min-w-[500px]">
                            <thead>
                                <tr class="bg-choc-800 text-gold-400 border-b border-gold-500/20">
                                    <th class="p-2 w-20 sticky left-0 bg-choc-800 z-10">Deskripsi</th>
                                    <th class="p-2">Jan</th><th class="p-2">Feb</th><th class="p-2">Mar</th><th class="p-2">Apr</th>
                                    <th class="p-2">Mei</th><th class="p-2">Jun</th><th class="p-2">Jul</th><th class="p-2">Agu</th>
                                    <th class="p-2">Sep</th><th class="p-2">Okt</th><th class="p-2">Nov</th><th class="p-2">Des</th>
                                    <th class="p-2 font-bold text-emerald-400">Total</th>
                                </tr>
                            </thead>
                            <tbody id="table-rekap-body"></tbody>
                        </table>
                    </div>
                </div>

                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 space-y-3 mb-10 shadow-lg">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400">Transaksi Terakhir</h3>
                        <button onclick="window.nav('transaksi')" class="text-[10px] text-gold-400 bg-choc-800 px-2 py-1 rounded">Lihat Semua</button>
                    </div>
                    <div id="dash-recent-tx" class="space-y-2"></div>
                </div>
            </section>

            <section id="page-transaksi" class="space-y-5 hidden">
                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 space-y-3 shadow-lg">
                    <div class="flex items-center justify-between border-b border-gold-500/10 pb-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-2"><i class="fas fa-arrow-down"></i> Riwayat Pemasukan</h3>
                        <span id="tx-in-count" class="text-[10px] text-emerald-400/80 bg-emerald-900/20 px-2 py-0.5 rounded border border-emerald-500/20">0 Data</span>
                    </div>
                    <div id="tx-in-list" class="space-y-2 max-h-[40vh] overflow-y-auto no-scrollbar pb-2"></div>
                </div>

                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 space-y-3 mb-10 shadow-lg">
                    <div class="flex items-center justify-between border-b border-gold-500/10 pb-2">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-rose-400 flex items-center gap-2"><i class="fas fa-arrow-up"></i> Riwayat Pengeluaran</h3>
                        <span id="tx-out-count" class="text-[10px] text-rose-400/80 bg-rose-900/20 px-2 py-0.5 rounded border border-rose-500/20">0 Data</span>
                    </div>
                    <div id="tx-out-list" class="space-y-2 max-h-[40vh] overflow-y-auto no-scrollbar pb-5"></div>
                </div>
            </section>

            <section id="page-hr" class="space-y-5 hidden">
                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 space-y-3 shadow-lg">
                    <div class="flex items-center justify-between">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400">Master Data Tukang</h3>
                        <div class="flex gap-2">
                            <button onclick="window.openKasbonModal()" class="px-2 py-1.5 bg-choc-800 border border-rose-500/30 text-rose-400 hover:bg-rose-900/40 rounded-lg text-[10px] font-bold active:scale-95 shadow-sm transition-colors"><i class="fas fa-hand-holding-dollar"></i> Kasbon</button>
                            <button onclick="window.openWorkerModal()" class="px-3 py-1.5 bg-choc-800 border border-gold-500/40 text-gold-400 hover:bg-choc-700 rounded-lg text-[10px] font-bold active:scale-95 shadow-sm transition-colors">Kelola Tim</button>
                        </div>
                    </div>
                    <div id="worker-summary-chips" class="flex flex-wrap gap-2 pt-1"></div>
                </div>

                <div class="glass-panel p-5 rounded-2xl border border-gold-500/20 space-y-4 shadow-lg bg-choc-800/40">
                    <div class="flex justify-between items-center">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400 flex items-center gap-2"><i class="fas fa-calendar-check"></i> Absensi Kolektif</h3>
                        <button onclick="window.openAttendanceHistory()" class="px-2.5 py-1.5 bg-choc-800 border border-gold-500/40 text-gold-400 rounded-lg text-[10px] font-bold active:scale-95">Lihat Absen</button>
                    </div>
                    <div class="space-y-3 text-xs">
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="text-cream/70 block mb-1">Tanggal Absen</label>
                                <input type="date" id="abs-tanggal" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-2.5 text-cream focus:outline-none">
                            </div>
                            <div>
                                <label class="text-cream/70 block mb-1">Pilih Project</label>
                                <select id="abs-project-select" onchange="window.renderCollectiveAttendance()" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-2.5 text-cream focus:outline-none"></select>
                            </div>
                        </div>
                        <div id="collective-attendance-container" class="space-y-2 mt-3 max-h-[45vh] overflow-y-auto no-scrollbar hidden"></div>
                        <button id="btn-save-collective-abs" onclick="window.saveCollectiveAttendance()" class="w-full py-3.5 bg-choc-800 text-gold-400 border border-gold-500/40 font-bold rounded-xl active:scale-95 text-xs uppercase tracking-wider hidden shadow-lg">Simpan Absen</button>
                    </div>
                </div>

                <div class="glass-panel p-5 rounded-2xl border border-gold-500/20 space-y-4 shadow-lg bg-choc-800/40">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400 flex items-center gap-2"><i class="fas fa-file-invoice-dollar"></i> Cetak Gaji Mingguan</h3>
                    <div class="space-y-3 text-xs">
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="text-cream/70 block mb-1">Pilih Project</label>
                                <select id="payroll-project-select" onchange="window.triggerAutoPayrollCalculations()" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-3 text-cream focus:outline-none"></select>
                            </div>
                            <div>
                                <label class="text-cream/70 block mb-1">Pilih Pekerja</label>
                                <select id="payroll-worker-select" onchange="window.triggerAutoPayrollCalculations()" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-3 text-cream focus:outline-none"></select>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <div class="flex justify-between mb-1"><label class="text-cream/70 block">Hari Kerja</label><span class="text-[9px] text-cream/30 px-1.5 rounded" id="abs-hari-note">Terkunci</span></div>
                                <input type="number" step="0.5" id="p-hari-kerja" placeholder="0" readonly class="w-full bg-choc-900/50 border border-gold-500/10 rounded-xl px-3 py-3 text-gold-300 font-bold cursor-not-allowed">
                            </div>
                            <div>
                                <div class="flex justify-between mb-1"><label class="text-cream/70 block">Lembur (Jam)</label><span class="text-[9px] text-cream/30 px-1.5 rounded" id="abs-jam-note">Terkunci</span></div>
                                <input type="number" id="p-jam-lembur" placeholder="0" readonly class="w-full bg-choc-900/50 border border-gold-500/10 rounded-xl px-3 py-3 text-gold-300 font-bold cursor-not-allowed">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3 mt-1">
                            <div>
                                <label class="text-cream/70 block mb-1">Upah Tambahan</label>
                                <input type="number" id="p-tambahan" placeholder="0" class="w-full bg-choc-800/80 border border-gold-500/30 rounded-xl px-3 py-3 text-emerald-400 focus:outline-none">
                            </div>
                            <div>
                                <div class="flex justify-between mb-1"><label class="text-cream/70 block">Potong Kasbon</label><span class="text-[9px] text-cream/30 px-1.5 rounded" id="kasbon-note">Terkunci</span></div>
                                <input type="number" id="p-kasbon" placeholder="0" class="w-full bg-choc-800/80 border border-rose-500/30 rounded-xl px-3 py-3 text-rose-400 font-bold focus:outline-none">
                            </div>
                        </div>
                        <input type="hidden" id="p-jabatan"><input type="hidden" id="p-harian">
                        <button onclick="window.calculateAndSavePayroll()" class="w-full py-3.5 bg-gradient-to-r from-gold-600 to-gold-400 text-choc-900 font-bold rounded-xl shadow-lg active:scale-95 text-xs uppercase tracking-wider mt-2">Terbitkan Gaji & Potong Otomatis</button>
                    </div>
                </div>

                <div class="glass-panel p-5 rounded-2xl border border-gold-500/20 space-y-4 shadow-lg bg-choc-800/40">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400 flex items-center gap-2"><i class="fas fa-print"></i> Rekap Gaji Mingguan</h3>
                    <div class="space-y-3 text-xs">
                        <div>
                            <label class="text-cream/70 block mb-1">Sumber Data Rekap</label>
                            <select id="rekap-data-source" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-3 text-cream focus:outline-none">
                                <option value="absensi">Dari Absensi (Estimasi Tagihan Baru)</option>
                                <option value="slip">Dari Slip Gaji (Riwayat Telah Dibayar)</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-cream/70 block mb-1">Pilih Project</label>
                            <select id="rekap-project-select" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-3 text-cream focus:outline-none"></select>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="text-cream/70 block mb-1">Dari Tanggal</label>
                                <input type="date" id="rekap-start-date" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-2.5 text-cream focus:outline-none">
                            </div>
                            <div>
                                <label class="text-cream/70 block mb-1">Sampai Tanggal</label>
                                <input type="date" id="rekap-end-date" class="w-full bg-choc-800 border border-gold-500/30 rounded-xl px-3 py-2.5 text-cream focus:outline-none">
                            </div>
                        </div>
                        <button onclick="window.previewRekapGaji()" class="w-full py-3.5 bg-gradient-to-r from-sky-600 to-sky-400 text-white font-bold rounded-xl shadow-lg active:scale-95 text-xs uppercase tracking-wider mt-2 hover:from-sky-500 hover:to-sky-300 transition-all"><i class="fas fa-file-invoice"></i> Buat Rekap (Preview)</button>
                    </div>
                </div>

                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 space-y-3 shadow-lg">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400">Riwayat Laporan Rekap</h3>
                    <div id="rekap-history-list" class="space-y-3 max-h-[30vh] overflow-y-auto no-scrollbar pb-2"></div>
                </div>

                <div class="glass-panel p-4 rounded-2xl border border-gold-500/20 space-y-3 mb-10 shadow-lg">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400">Riwayat Slip Penggajian</h3>
                    <div id="payroll-list" class="space-y-3 max-h-[40vh] overflow-y-auto no-scrollbar pb-5"></div>
                </div>
            </section>

            <section id="page-project" class="space-y-5 hidden">
                <div class="glass-panel p-5 rounded-2xl border border-gold-500/20 space-y-4 shadow-lg">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gold-400 flex items-center gap-2"><i class="fas fa-folder-plus text-gold-500"></i> Buat Project Baru (RAB)</h3>
                    
                    <div class="space-y-3 text-xs">
                        <input type="text" id="proj-nama" placeholder="Nama Project (Cth: Showroom VIP)" class="w-full bg-choc-800/80 border border-gold-500/30 rounded-xl px-3 py-3 text-cream focus:outline-none shadow-inner">
                        
                        <div class="bg-choc-900/50 p-3 rounded-xl border border-gold-500/20 space-y-2 shadow-inner">
                            <div class="flex justify-between items-center mb-2 border-b border-gold-500/20 pb-2">
