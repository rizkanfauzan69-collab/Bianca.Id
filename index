        window.saveEditProject = function() {
            const nama = document.getElementById('edit-proj-nama').value; const res = window.calcEditProjLive();
            if (!nama || res.totalNilai <= 0) { window.showModal("Gagal", "Nama project dan rincian harga tidak boleh kosong.", "alert"); return; }

            const pIdx = state.projects.findIndex(x => x.id === editProjectId); if (pIdx === -1) return;
            const oldName = state.projects[pIdx].nama;
            
            if (oldName !== nama) {
                state.transactions.forEach(t => { if(t.project === oldName) t.project = nama; });
                state.attendances.forEach(a => { if(a.project === oldName) a.project = nama; });
                state.payrolls.forEach(pr => { if(pr.project === oldName) pr.project = nama; });
            }

            state.projects[pIdx].nama = nama; state.projects[pIdx].nilai = res.totalNilai;
            state.projects[pIdx].tukangAlokasi = res.tukangVal; state.projects[pIdx].bahanAlokasi = res.bahanVal;
            state.projects[pIdx].marginAlokasi = res.marginVal; state.projects[pIdx].timelineHari = res.timelineHari;

            const existingRabs = state.rabs.filter(r => r.projectId === editProjectId);

            state.rabs = state.rabs.filter(r => r.projectId !== editProjectId);
            editRabRows.forEach(r => {
                if (r.kerja) { 
                    const existing = existingRabs.find(ex => ex.id === r.id);
                    const volReal = existing ? (existing.volReal || 0) : 0;
                    state.rabs.push({ id: r.id || generateId(), projectId: editProjectId, kerja: r.kerja, ukuran: r.ukuran, harga: r.harga, finish: r.finish, hargaF: r.hargaF, volReal: volReal }); 
