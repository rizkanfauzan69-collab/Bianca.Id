            }).join('');
            
            const headerDateRange = `${startParts[2]}/${startParts[1]}/${startParts[0]} - ${endParts[2]}/${endParts[1]}/${endParts[0]}`;

            const absensiHTML = `
                <div class="overflow-x-auto no-scrollbar pb-4">
