        window.calcEditProjLive = function() {
            let totalNilai = 0;
            editRabRows.forEach(r => {
                const u = window.safeParseFloat(r.ukuran) || 0;
                const h = window.safeParseFloat(r.harga) || 0;
                const hf = window.safeParseFloat(r.hargaF) || 0;
                totalNilai += (u * h) + (u * hf);
            });

            document.getElementById('edit-proj-nilai-display').innerText = formatRp(totalNilai);
            const upahHarian = window.safeParseFloat(document.getElementById('edit-proj-upah-harian').value) || 0;
            const pctTukang = window.safeParseFloat(document.getElementById('edit-pct-tukang').value) || 0;
            const pctBahan = window.safeParseFloat(document.getElementById('edit-pct-bahan').value) || 0;
            const pctMargin = window.safeParseFloat(document.getElementById('edit-pct-margin').value) || 0;

            const tukangVal = (totalNilai * pctTukang) / 100; const bahanVal = (totalNilai * pctBahan) / 100; const marginVal = (totalNilai * pctMargin) / 100;
            const timelineHari = upahHarian > 0 ? Math.ceil(tukangVal / upahHarian) : 0;

            document.getElementById('edit-prev-tukang').innerText = formatRp(tukangVal);
            document.getElementById('edit-prev-bahan').innerText = formatRp(bahanVal);
            document.getElementById('edit-prev-margin').innerText = formatRp(marginVal);
            document.getElementById('edit-prev-timeline').innerText = `${timelineHari} Hari Kerja`;
            return { totalNilai, tukangVal, bahanVal, marginVal, timelineHari };
