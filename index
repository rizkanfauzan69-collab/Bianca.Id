        window.saveProgress = function() {
            const id = document.getElementById('prog-project-id').value;
            const rabs = state.rabs.filter(r => r.projectId === id);
            
            let updatedCount = 0;
            rabs.forEach(r => {
                const input = document.getElementById(`prog-vol-${r.id}`);
                if (input) {
