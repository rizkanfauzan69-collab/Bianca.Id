    <!-- UNIVERSAL ALERT MODAL -->
    <div id="custom-modal" class="fixed inset-0 z-[300] bg-choc-900/95 flex items-center justify-center p-4 hidden transition-opacity duration-300 opacity-0">
        <div id="custom-modal-content" class="glass-panel p-6 rounded-2xl max-w-sm w-full shadow-2xl border border-gold-500/30 transform scale-95 transition-transform duration-300 modal-scrollable flex flex-col">
            <h3 id="custom-modal-title" class="font-bold text-gold-400 text-sm uppercase mb-2 border-b border-gold-500/20 pb-2 shrink-0"></h3>
            <div id="custom-modal-message" class="text-xs text-cream/90 mb-5 mt-3 leading-relaxed w-full"></div>
            <div id="custom-modal-buttons" class="flex gap-2 shrink-0 pt-2 border-t border-gold-500/20"></div>
        </div>
