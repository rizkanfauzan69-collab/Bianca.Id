    <script>
        // Mendaftarkan Service Worker
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('sw.js')
                    .then(reg => console.log('Service Worker terdaftar dengan sukses! Scope:', reg.scope))
                    .catch(err => console.log('Service Worker gagal terdaftar', err));
            });
        }

        const DB_NAME = 'BiancaLocalDB_v2';
        const DB_VERSION = 2;
        const STORE_NAME = 'appState';
        
        let state = { transactions: [], workers: [], payrolls: [], projects: [], attendances: [], rabs: [], photos: {}, salaryRecaps: [] };
        let dbInstance = null;
        let currentDashboardYear = new Date().getFullYear();
        let currentRabRows = [{ id: 'rab-1', kerja: '', ukuran: '', harga: '', finish: '', hargaF: '' }];
        let barChartInstance = null;
        let pieChartInstance = null;
        let editRabRows = [];
        let editProjectId = null;
        
        let stateHistory = [];
        let stateFuture = [];
        let isUndoRedoAction = false;
        let lastSerializedState = "";

        const formatRp = (num) => 'Rp ' + parseInt(num || 0).toLocaleString('id-ID');
        const generateId = () => Math.random().toString(36).substr(2, 9);
        const getTodayDateInput = () => { const d = new Date(); return d.toISOString().split('T')[0]; };
        
        window.safeParseFloat = function(val) {
            if (val === undefined || val === null || val === '') return 0;
            if (typeof val === 'number') return isNaN(val) ? 0 : val;
            let str = String(val).toLowerCase().replace(/rp/g, '').replace(/idr/g, '').trim();
            if (str.length > 15 && str.includes('t') && str.includes('z') && str.includes('-')) return 0;
            let lastDot = str.lastIndexOf('.');
            let lastComma = str.lastIndexOf(',');
            if (lastDot > -1 && lastComma > -1) {
                if (lastDot > lastComma) { str = str.replace(/,/g, ''); } 
                else { str = str.replace(/\./g, '').replace(',', '.'); }
            } else if (lastComma > -1) {
                let parts = str.split(',');
                if (parts[parts.length - 1].length === 3) str = str.replace(/,/g, ''); 
                else str = str.replace(',', '.');
            } else if (lastDot > -1) {
                let parts = str.split('.');
                if (parts[parts.length - 1].length === 3) str = str.replace(/\./g, ''); 
            }
            str = str.replace(/[^0-9.-]/g, '');
            const parsed = parseFloat(str);
            return isNaN(parsed) ? 0 : parsed;
        };

        function cleanDate(dateStr) {
            if(!dateStr) return "-";
            if(String(dateStr).includes('T') && String(dateStr).includes('Z')) {
                try {
                    const d = new Date(dateStr);
                    return `${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`;
                } catch(e) { return dateStr; }
            }
            return dateStr;
        }

        function getRealTimeIndonesianDate() {
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            return new Date().toLocaleDateString('id-ID', options);
        }

        function parseIndoDate(dateStr) {
            let dString = cleanDate(dateStr);
            if(!dString) return null;
            if(typeof dString === 'string' && dString.includes('/')) {
                const parts = dString.split('/');
                if(parts.length >= 3) return { m: parseInt(parts[1]) - 1, y: parseInt(parts[2]) };
            } else {
                const dObj = new Date(dString);
                if (!isNaN(dObj.getTime())) return { m: dObj.getMonth(), y: dObj.getFullYear() };
            }
            return null;
        }

        function initDB() {
            return new Promise((resolve, reject) => {
                if (!window.indexedDB) { reject("No IDB"); return; }
                const req = indexedDB.open(DB_NAME, DB_VERSION);
                req.onerror = e => reject("DB Error");
                req.onsuccess = e => { dbInstance = e.target.result; resolve(dbInstance); };
                req.onupgradeneeded = e => {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains(STORE_NAME)) db.createObjectStore(STORE_NAME);
                };
            });
        }

        function saveStateToDB() {
            try {
                const textState = {
                    transactions: state.transactions, workers: state.workers,
                    payrolls: state.payrolls, projects: state.projects,
                    attendances: state.attendances, rabs: state.rabs,
                    salaryRecaps: state.salaryRecaps
                };
                localStorage.setItem('bianca_text_db', JSON.stringify(textState));
            } catch(e) { console.error("LS Save Error", e); }

            if (window.indexedDB) {
                initDB().then(db => {
                    const tx = db.transaction(STORE_NAME, 'readwrite');
                    tx.objectStore(STORE_NAME).put(state.photos || {}, 'photosDB');
                }).catch(e => console.log("IDB Error", e));
            }
        }

        async function loadStateFromDB() {
            try {
                const ls = localStorage.getItem('bianca_text_db');
                if (ls) {
                    const parsed = JSON.parse(ls);
                    state.transactions = parsed.transactions || []; state.workers = parsed.workers || [];
                    state.payrolls = parsed.payrolls || []; state.projects = parsed.projects || [];
                    state.attendances = parsed.attendances || []; state.rabs = parsed.rabs || [];
                    state.salaryRecaps = parsed.salaryRecaps || [];
                }
                
                const savedApiKey = localStorage.getItem('bianca_gemini_key');
                if(savedApiKey && document.getElementById('ai-api-key')) {
                    document.getElementById('ai-api-key').value = savedApiKey;
                }
            } catch(e) { console.error("LS Load Error", e); }

            lastSerializedState = JSON.stringify({
                transactions: state.transactions, workers: state.workers, payrolls: state.payrolls,
                projects: state.projects, attendances: state.attendances, rabs: state.rabs, salaryRecaps: state.salaryRecaps
            });
            updateUndoRedoUI();

            state.photos = {};
            if (window.indexedDB) {
                try {
                    const db = await initDB();
                    return new Promise((resolve) => {
                        const tx = db.transaction(STORE_NAME, 'readonly');
                        const req = tx.objectStore(STORE_NAME).get('photosDB');
                        req.onsuccess = () => { if (req.result) state.photos = req.result; resolve(); };
                        req.onerror = () => resolve();
                    });
                } catch(e) { console.log("IDB load error", e); return Promise.resolve(); }
            } else { return Promise.resolve(); }
        }

        function fullSaveAndRefresh() {
            const currentStateStr = JSON.stringify({
                transactions: state.transactions, workers: state.workers, payrolls: state.payrolls,
                projects: state.projects, attendances: state.attendances, rabs: state.rabs, salaryRecaps: state.salaryRecaps
            });
            if (!isUndoRedoAction && currentStateStr !== lastSerializedState && lastSerializedState !== "") {
                stateHistory.push(lastSerializedState);
                if (stateHistory.length > 30) stateHistory.shift();
                stateFuture = [];
                updateUndoRedoUI();
            }
            lastSerializedState = currentStateStr;
            isUndoRedoAction = false;

            saveStateToDB(); updateDashboard(); renderTransactions(); 
            renderWorkerDropdown(); renderProjectDropdown(); renderWorkerListModal(); 
            renderPayrollList(); renderProjectList(); window.renderRabRows();
            if(window.renderRekapHistory) window.renderRekapHistory();
        }
        
        window.undo = function() {
            if (stateHistory.length === 0) return;
            stateFuture.push(lastSerializedState);
            const prevStateStr = stateHistory.pop();
            const prevState = JSON.parse(prevStateStr);
            Object.assign(state, prevState);
            isUndoRedoAction = true;
            lastSerializedState = prevStateStr;
            updateUndoRedoUI();
            fullSaveAndRefresh();
        };

        window.redo = function() {
            if (stateFuture.length === 0) return;
            stateHistory.push(lastSerializedState);
            const nextStateStr = stateFuture.pop();
            const nextState = JSON.parse(nextStateStr);
            Object.assign(state, nextState);
            isUndoRedoAction = true;
            lastSerializedState = nextStateStr;
            updateUndoRedoUI();
            fullSaveAndRefresh();
        };

        window.updateUndoRedoUI = function() {
            const btnUndo = document.getElementById('btn-undo'); const btnRedo = document.getElementById('btn-redo');
            if(btnUndo) {
                if(stateHistory.length > 0) { btnUndo.disabled = false; btnUndo.classList.remove('text-cream/20'); btnUndo.classList.add('text-sky-400'); }
                else { btnUndo.disabled = true; btnUndo.classList.add('text-cream/20'); btnUndo.classList.remove('text-sky-400'); }
            }
            if(btnRedo) {
                if(stateFuture.length > 0) { btnRedo.disabled = false; btnRedo.classList.remove('text-cream/20'); btnRedo.classList.add('text-sky-400'); }
                else { btnRedo.disabled = true; btnRedo.classList.add('text-cream/20'); btnRedo.classList.remove('text-sky-400'); }
            }
        };

        window.showModal = function(title, message, type, onConfirm) {
            const modal = document.getElementById('custom-modal'); const modalContent = document.getElementById('custom-modal-content');
            document.getElementById('custom-modal-title').innerText = title; document.getElementById('custom-modal-message').innerHTML = message;
            const btnContainer = document.getElementById('custom-modal-buttons');
            if (type === 'alert') { btnContainer.innerHTML = `<button onclick="window.closeModal()" class="py-2.5 bg-gradient-to-r from-gold-600 to-gold-400 text-choc-900 font-bold rounded-xl w-full shadow text-xs">TUTUP</button>`; } 
            else if (type === 'confirm') {
                btnContainer.innerHTML = `
                    <button onclick="window.closeModal()" class="py-2.5 bg-choc-800 text-gold-400 border border-gold-500/30 font-bold rounded-xl w-1/2 text-xs">Batal</button>
                    <button id="modal-confirm-btn" class="py-2.5 bg-gradient-to-r from-gold-600 to-gold-400 text-choc-900 font-bold rounded-xl w-1/2 shadow text-xs">Lanjutkan</button>
                `;
                document.getElementById('modal-confirm-btn').onclick = () => { window.closeModal(); if (onConfirm) onConfirm(); };
            }
            modal.classList.remove('hidden'); void modal.offsetWidth;
            modal.classList.remove('opacity-0'); modalContent.classList.remove('scale-95');
        };

        window.closeModal = function() {
            const modal = document.getElementById('custom-modal'); const modalContent = document.getElementById('custom-modal-content');
            modal.classList.add('opacity-0'); modalContent.classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 300);
        };

        window.handleLogin = async function() {
            const pass = document.getElementById('login-password').value;
            if (pass.toLowerCase() === 'sukses' || pass === '') {
                const loginScreen = document.getElementById('login-screen');
                loginScreen.classList.add('opacity-0');
                try { await loadStateFromDB(); } catch(e) { console.error("Load failed", e); }
                state.projects = state.projects.filter(p => p.nama && p.nama !== "Tanpa Nama" && window.safeParseFloat(p.nilai) > 0);
                setTimeout(() => { 
                    loginScreen.classList.add('hidden'); 
                    document.getElementById('main-app').classList.remove('hidden'); 
                    fullSaveAndRefresh();
                }, 500);
            } else { window.showModal("Kata Sandi Salah", "Gunakan kata sandi yang valid.", "alert"); }
        };

        window.nav = function(pageId) {
            ['dashboard', 'transaksi', 'hr', 'project', 'ai'].forEach(p => {
                const sec = document.getElementById(`page-${p}`); const btn = document.getElementById(`nav-btn-${p}`);
                if (p === pageId) { sec.classList.remove('hidden'); sec.classList.remove('animate-slide-up'); void sec.offsetWidth; sec.classList.add('animate-slide-up'); btn.classList.add('text-gold-400'); btn.classList.remove('text-cream/40'); } 
                else { sec.classList.add('hidden'); btn.classList.remove('text-gold-400'); btn.classList.add('text-cream/40'); }
            });
            if (pageId === 'dashboard') updateDashboard();
            if (pageId === 'hr') { 
                const today = getTodayDateInput();
                document.getElementById('abs-tanggal').value = today; 
                
                const d = new Date();
                document.getElementById('rekap-end-date').value = today;
                d.setDate(d.getDate() - 6);
                document.getElementById('rekap-start-date').value = d.toISOString().split('T')[0];
                
                window.renderCollectiveAttendance(); 
                if(window.renderRekapHistory) window.renderRekapHistory();
            }
            if (pageId === 'project') { window.renderRabRows(); }
        };
        
        window.openSettings = function() { document.getElementById('settings-modal').classList.remove('hidden'); };
        window.changeYear = function(offset) { currentDashboardYear += offset; updateDashboard(); };

        function updateDashboard() {
            let totalMasukGlobal = 0; let totalKeluarGlobal = 0;
            document.getElementById('chart-year-label').innerText = currentDashboardYear;

            state.transactions.forEach(t => {
                const amt = parseFloat(t.amount) || 0;
                if (t.type === 'pemasukan') totalMasukGlobal += amt;
                else totalKeluarGlobal += amt;
            });
            
            document.getElementById('dash-saldo').innerText = formatRp(totalMasukGlobal - totalKeluarGlobal);
            document.getElementById('dash-masuk').innerText = formatRp(totalMasukGlobal);
            document.getElementById('dash-keluar').innerText = formatRp(totalKeluarGlobal);

            const recentContainer = document.getElementById('dash-recent-tx'); recentContainer.innerHTML = '';
            const recent = [...state.transactions].reverse().slice(0, 4);
            if (recent.length === 0) recentContainer.innerHTML = `<p class="text-xs text-cream/40 text-center py-2">Belum ada transaksi.</p>`;
            else {
                recent.forEach((t) => {
                    const isInc = t.type === 'pemasukan';
                    let pName = t.project && t.project !== 'Tanpa Nama' ? `<span class="text-emerald-400/80"> • ${t.project}</span>` : '';
                    recentContainer.innerHTML += `
                        <div class="flex items-center justify-between p-2.5 bg-choc-800 rounded-xl text-xs border border-gold-500/10 shadow-sm">
                            <div class="truncate pr-2 max-w-[70%]">
                                <p class="font-bold text-cream truncate">${t.desc}</p>
                                <p class="text-[9px] text-gold-400 truncate">${cleanDate(t.date)} • ${t.category.toUpperCase()} ${pName}</p>
                            </div>
                            <span class="font-bold ${isInc ? 'text-emerald-400' : 'text-rose-400'} shrink-0">${isInc ? '+' : '-'}${formatRp(t.amount)}</span>
                        </div>
                    `;
                });
            }
            updateAdvancedCharts(currentDashboardYear);
        }

        function updateAdvancedCharts(year) {
            let inBulan = Array(12).fill(0); let outBulan = Array(12).fill(0);
            document.getElementById('pie-chart-title').innerText = `Distribusi Pengeluaran ${year}`;
            document.getElementById('table-rekap-title').innerText = `Laporan Rinci ${year}`;

            let tMat = 0; let tUpah = 0; let tOps = 0; let tInYear = 0; let tOutYear = 0;

            state.transactions.forEach(t => {
                const parsedD = parseIndoDate(t.date);
                if (parsedD && parsedD.y === year) {
                    const amt = parseFloat(t.amount) || 0;
                    if (t.type === 'pemasukan') { inBulan[parsedD.m] += amt; tInYear += amt; } 
                    else {
                        outBulan[parsedD.m] += amt; tOutYear += amt;
                        const cat = (t.category || '').toLowerCase();
                        if (cat === 'material') tMat += amt;
                        else if (cat === 'gaji') tUpah += amt;
                        else tOps += amt; 
                    }
                }
            });

            let margin = Math.max(0, tInYear - tOutYear);
            document.getElementById('sum-margin').innerText = formatRp(tInYear - tOutYear);
            document.getElementById('sum-margin').className = (tInYear - tOutYear >= 0) ? "font-bold text-emerald-400" : "font-bold text-rose-500";
            document.getElementById('sum-mat').innerText = formatRp(tMat);
            document.getElementById('sum-upah').innerText = formatRp(tUpah);
            document.getElementById('sum-ops').innerText = formatRp(tOps);

            if (barChartInstance) barChartInstance.destroy();
            const barCtx = document.getElementById('barChart').getContext('2d');
            barChartInstance = new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'],
                    datasets: [
                        { label: 'Pendapatan', data: inBulan, backgroundColor: '#10B981', borderRadius: 4, barPercentage: 0.8, categoryPercentage: 0.9 },
                        { label: 'Pengeluaran', data: outBulan, backgroundColor: '#F43F5E', borderRadius: 4, barPercentage: 0.8, categoryPercentage: 0.9 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#C5A059', font: { size: 8 } }, grid: { display: false } }, y: { ticks: { display: false }, grid: { color: 'rgba(197, 160, 89, 0.1)' } } } }
            });

            if (pieChartInstance) pieChartInstance.destroy();
            const pieCtx = document.getElementById('pieChart').getContext('2d');
            const hasData = (margin + tMat + tUpah + tOps) > 0;
            pieChartInstance = new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Margin', 'Material', 'Upah', 'Lainnya'],
                    datasets: [{ data: hasData ? [margin, tMat, tUpah, tOps] : [1], backgroundColor: hasData ? ['#10B981', '#F43F5E', '#0EA5E9', '#F59E0B'] : ['#3D2C1F'], borderWidth: 0 }]
                },
                options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { display: false } } }
            });

