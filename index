        window.previewRekapGaji = function() {
            const pName = document.getElementById('rekap-project-select').value;
            const startDateStr = document.getElementById('rekap-start-date').value; 
            const endDateStr = document.getElementById('rekap-end-date').value; 
            const dataSource = document.getElementById('rekap-data-source').value;

            if (!pName || !startDateStr || !endDateStr) {
                window.showModal("Data Tidak Lengkap", "Pilih Project, Tanggal Mulai, dan Tanggal Akhir.", "alert");
                return;
            }

            const startParts = startDateStr.split('-');
            const endParts = endDateStr.split('-');
            
            const startD = new Date(parseInt(startParts[0]), parseInt(startParts[1]) - 1, parseInt(startParts[2]), 0, 0, 0);
            const endD = new Date(parseInt(endParts[0]), parseInt(endParts[1]) - 1, parseInt(endParts[2]), 23, 59, 59);
            
            const headerDateRange = `${startParts[2]}/${startParts[1]}/${startParts[0]} - ${endParts[2]}/${endParts[1]}/${endParts[0]}`;

            let grandTotal = 0;
            let structuredItems = [];

            const parseDateObj = (dateStr) => {
                if(!dateStr) return null;
                if(dateStr.includes('/')) {
                    const parts = dateStr.split('/');
                    if(parts.length >= 3) return new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]), 12, 0, 0);
                } else if (dateStr.includes('-')) {
                    const parts = dateStr.split('-');
                    if(parts.length >= 3) return new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]), 12, 0, 0);
                }
                return null;
            };

            if (dataSource === 'absensi') {
                let rekapData = {};
                let hasDataInRange = false;
                let hasUnpaid = false;

                state.attendances.forEach(a => {
                    if (a.project.toLowerCase() === pName.toLowerCase()) {
                        const aDate = parseDateObj(a.date);
                        if (aDate && aDate >= startD && aDate <= endD) {
                            hasDataInRange = true;
                            if (a.status === 'Belum Dibayar') {
                                hasUnpaid = true;
                                if (!rekapData[a.workerId]) {
                                    rekapData[a.workerId] = { workerId: a.workerId, hari: 0, jam: 0 };
                                }
                                rekapData[a.workerId].hari += (parseFloat(a.hari) || 0);
                                rekapData[a.workerId].jam += (parseFloat(a.jam) || 0);
                            }
                        }
                    }
                });

                if (!hasDataInRange) {
                    window.showModal("Tidak Ada Data", "Tidak ada absensi pada rentang tanggal tersebut untuk project ini.", "alert"); 
                    return;
                }
                
                if (!hasUnpaid && hasDataInRange) {
                    window.showModal("Gaji Telah Dibayar", "Data absensi pada rentang tanggal ini sudah direkap/dibayar. Silakan pilih sumber data <strong>Dari Slip Gaji</strong> untuk melihat riwayat.", "alert");
                    return;
                }

                const rows = Object.values(rekapData);
                if (rows.length === 0) { window.showModal("Tidak Ada Data", "Tidak ada absensi yang belum dibayar.", "alert"); return; }

                const calcKasbon = (wId, wNama, pName) => {
                    let totalKasbonTx = 0; let totalKasbonUsed = 0;
                    state.transactions.forEach(t => {
                        if(t.type === 'pengeluaran' && (t.category||'').toLowerCase() === 'kasbon') {
                            if(t.project && t.project.toLowerCase() === pName.toLowerCase()) {
                                if(t.worker && wNama.toLowerCase() === t.worker.toLowerCase()) { 
                                    totalKasbonTx += parseFloat(t.amount) || 0; 
                                }
                            }
                        }
                    });
                    state.payrolls.forEach(p => { if(p.workerId === wId && p.project && p.project.toLowerCase() === pName.toLowerCase()) { totalKasbonUsed += parseFloat(p.kasbon) || 0; } });
                    return Math.max(0, totalKasbonTx - totalKasbonUsed);
                };

                rows.forEach((r) => {
                    const w = state.workers.find(x => x.id === r.workerId);
                    if (w) {
                        const upahHari = parseFloat(w.harian) || 0; const upahLembur = parseFloat(w.lembur) || 0;
                        const sisaKasbon = calcKasbon(w.id, w.nama, pName);
                        const cicilan = window.safeParseFloat(w.potonganKasbon) || 0;
                        const potonganKasbon = (sisaKasbon > 0 && cicilan > 0) ? Math.min(sisaKasbon, cicilan) : sisaKasbon;
                        const kotor = (r.hari * upahHari) + (r.jam * upahLembur);
                        const bersih = kotor - potonganKasbon;
                        
                        grandTotal += bersih;
                        structuredItems.push({ jabatan: w.jabatan, nama: w.nama, upahHari: upahHari, hari: r.hari, upahLembur: upahLembur, jam: r.jam, potongan: potonganKasbon, bersih: bersih });
                    }
                });
            } else {
                let rekapData = {};
                state.payrolls.forEach(p => {
                    if (p.project.toLowerCase() === pName.toLowerCase()) {
                        const pDate = parseDateObj(p.date);
                        if (pDate && pDate >= startD && pDate <= endD) {
                            if (!rekapData[p.workerId]) {
                                rekapData[p.workerId] = { workerId: p.workerId, nama: p.nama, jabatan: p.jabatan, hari: 0, jam: 0, potongan: 0, bersih: 0 };
                            }
                            rekapData[p.workerId].hari += (parseFloat(p.hari) || 0);
                            rekapData[p.workerId].jam += (parseFloat(p.jam) || 0);
                            rekapData[p.workerId].potongan += (parseFloat(p.kasbon) || 0);
                            rekapData[p.workerId].bersih += (parseFloat(p.bersih) || 0);
                        }
                    }
                });

                const rows = Object.values(rekapData);
                if (rows.length === 0) { 
                    let hasUnpaidAttendances = false;
                    state.attendances.forEach(a => {
                        if (a.project.toLowerCase() === pName.toLowerCase() && a.status === 'Belum Dibayar') {
                            const aDate = parseDateObj(a.date);
                            if (aDate && aDate >= startD && aDate <= endD) {
                                hasUnpaidAttendances = true;
                            }
                        }
                    });

                    if (hasUnpaidAttendances) {
                        window.showModal("Absensi Belum Terbayar", "Belum ada slip gaji pada rentang tanggal ini, namun ditemukan data absensi yang belum terbayar. Silakan pilih sumber data <strong>Dari Absensi</strong>.", "alert");
                    } else {
                        window.showModal("Tidak Ada Data", "Tidak ada slip gaji diterbitkan pada rentang tanggal tersebut.", "alert"); 
                    }
                    return; 
                }

                rows.forEach((r) => {
                    const w = state.workers.find(x => x.id === r.workerId);
                    const upahHari = w ? (parseFloat(w.harian) || 0) : 0;
                    const upahLembur = w ? (parseFloat(w.lembur) || 0) : 0;
                    grandTotal += r.bersih;
                    structuredItems.push({ jabatan: r.jabatan || '-', nama: r.nama, upahHari: upahHari, hari: r.hari, upahLembur: upahLembur, jam: r.jam, potongan: r.potongan, bersih: r.bersih });
                });
            }

            window.tempRekapData = {
                id: generateId(),
                project: pName,
                dateRange: headerDateRange,
                source: dataSource,
                total: grandTotal,
                items: structuredItems,
                timestamp: new Date().toISOString()
            };

            const rekapHTML = window.generateRekapHTML(pName, headerDateRange, structuredItems, grandTotal);

            window.showModal("Pratinjau Rekap Gaji", rekapHTML, 'alert');
            document.getElementById('custom-modal-buttons').innerHTML = `
                <button onclick="window.closeModal()" class="py-3 bg-choc-800 text-gold-400 font-bold rounded-xl text-xs flex-[0.8]">Tutup</button>
                <button onclick="window.saveRekap()" class="py-3 bg-gradient-to-r from-gold-600 to-gold-400 text-choc-900 font-bold rounded-xl shadow-lg text-xs flex-[1]"><i class="fas fa-save"></i> Simpan Riwayat</button>
                <button onclick="window.downloadDocPDF('rekap-to-download', 'Rekap_Gaji_${pName.replace(/\s+/g, '_')}_${startParts[2]}${startParts[1]}')" class="py-3 bg-sky-600 text-white font-bold rounded-xl shadow-lg text-xs flex-[1.2]"><i class="fas fa-file-pdf"></i> Unduh PDF</button>
            `;
        };

        window.saveRekap = function() {
            if (window.tempRekapData) {
                state.salaryRecaps.push(window.tempRekapData);
                window.tempRekapData = null;
                fullSaveAndRefresh();
                window.closeModal();
                window.showModal("Berhasil Disimpan", "Rekap gaji telah tersimpan di riwayat secara permanen.", "alert");
            }
