        window.addRabRow = function() { currentRabRows.push({ id: generateId(), kerja: '', ukuran: '', harga: '', finish: '', hargaF: '' }); window.renderRabRows(); };
        window.removeRabRow = function(id) { currentRabRows = currentRabRows.filter(r => r.id !== id); window.renderRabRows(); window.calcProjLive(); };
        window.updateRabField = function(id, field, value) { const row = currentRabRows.find(r => r.id === id); if (row) { row[field] = value; window.calcProjLive(); } };

        window.renderRabRows = function() {
            const container = document.getElementById('rab-container');
            container.innerHTML = currentRabRows.map((r, i) => `
                <div class="rab-row-animate bg-choc-800 p-2 rounded border border-gold-500/10 space-y-2 relative">
                    <div class="flex justify-between items-center">
                        <span class="text-[9px] font-bold text-gold-400 uppercase">Item ${i+1}</span>
                        ${i > 0 ? `<button onclick="window.removeRabRow('${r.id}')" class="text-[9px] text-rose-400"><i class="fas fa-times"></i> Hapus</button>` : ''}
                    </div>
                    <input type="text" placeholder="Jenis Pekerjaan" value="${r.kerja}" oninput="window.updateRabField('${r.id}', 'kerja', this.value)" class="w-full bg-choc-900 border border-gold-500/30 rounded px-2 py-1.5 text-cream text-[10px] focus:outline-none">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" placeholder="Ukuran (M2/M1)" value="${r.ukuran}" oninput="window.updateRabField('${r.id}', 'ukuran', this.value)" class="w-full bg-choc-900 border border-gold-500/30 rounded px-2 py-1.5 text-cream text-[10px] focus:outline-none">
                        <input type="number" placeholder="Harga/M2" value="${r.harga}" oninput="window.updateRabField('${r.id}', 'harga', this.value)" class="w-full bg-choc-900 border border-gold-500/30 rounded px-2 py-1.5 text-cream text-[10px] focus:outline-none">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" placeholder="Finishing (Cth: HPL)" value="${r.finish}" oninput="window.updateRabField('${r.id}', 'finish', this.value)" class="w-full bg-choc-900 border border-gold-500/30 rounded px-2 py-1.5 text-cream text-[10px] focus:outline-none">
                        <input type="number" placeholder="Harga Finish/M2" value="${r.hargaF}" oninput="window.updateRabField('${r.id}', 'hargaF', this.value)" class="w-full bg-choc-900 border border-gold-500/30 rounded px-2 py-1.5 text-cream text-[10px] focus:outline-none">
                    </div>
                </div>
            `).join('');
        };

        window.calcProjLive = function() {
            let totalNilai = 0;
            currentRabRows.forEach(r => {
                const u = window.safeParseFloat(r.ukuran) || 0; 
                const h = window.safeParseFloat(r.harga) || 0; 
                const hf = window.safeParseFloat(r.hargaF) || 0;
                totalNilai += (u * h) + (u * hf);
            });
            
            const elNilaiDisplay = document.getElementById('proj-nilai-display');
            if(elNilaiDisplay) elNilaiDisplay.innerText = formatRp(totalNilai);
            const elNilai = document.getElementById('proj-nilai');
            if(elNilai) elNilai.value = totalNilai;

            const upahHarian = window.safeParseFloat(document.getElementById('proj-upah-harian').value) || 0;
            const pctTukang = window.safeParseFloat(document.getElementById('pct-tukang').value) || 0;
            const pctBahan = window.safeParseFloat(document.getElementById('pct-bahan').value) || 0;
            const pctMargin = window.safeParseFloat(document.getElementById('pct-margin').value) || 0;

            const tukangVal = (totalNilai * pctTukang) / 100;
            const bahanVal = (totalNilai * pctBahan) / 100;
            const marginVal = (totalNilai * pctMargin) / 100;
            const timelineHari = upahHarian > 0 ? Math.ceil(tukangVal / upahHarian) : 0;

            if(document.getElementById('prev-tukang')) document.getElementById('prev-tukang').innerText = formatRp(tukangVal); 
            if(document.getElementById('prev-bahan')) document.getElementById('prev-bahan').innerText = formatRp(bahanVal);
            if(document.getElementById('prev-margin')) document.getElementById('prev-margin').innerText = formatRp(marginVal); 
            if(document.getElementById('prev-timeline')) document.getElementById('prev-timeline').innerText = `${timelineHari} Hari Kerja`;
            
            return { totalNilai, tukangVal, bahanVal, marginVal, timelineHari };
        };

        window.saveProject = function() {
            const nama = document.getElementById('proj-nama').value; const res = window.calcProjLive();
            if (!nama || res.totalNilai <= 0) { window.showModal("Gagal", "Nama project dan RAB tidak boleh kosong.", "alert"); return; }

            const cleanD = cleanDate(getTodayDateInput()); 
            const p = { id: generateId(), nama, nilai: res.totalNilai, date: cleanD, timelineHari: res.timelineHari, tukangAlokasi: res.tukangVal, bahanAlokasi: res.bahanVal, marginAlokasi: res.marginVal, terbayar: 0, catatan: '', statusTahapan: 'Pre-production' };
            state.projects.push(p); 
            
            currentRabRows.forEach(r => {
                if(r.kerja) { state.rabs.push({ id: r.id || generateId(), projectId: p.id, kerja: r.kerja, ukuran: r.ukuran, harga: r.harga, finish: r.finish, hargaF: r.hargaF, volReal: 0 }); }
            });

            document.getElementById('proj-nama').value = ''; document.getElementById('proj-upah-harian').value = '';
            currentRabRows = [{ id: 'rab-1', kerja: '', ukuran: '', harga: '', finish: '', hargaF: '' }];
            
            fullSaveAndRefresh(); window.printInvoice(p.id);
        };

