        window.deleteData = function(sheetName, id) {
            window.showModal("Hapus Data", `Yakin menghapus data ini secara permanen?`, "confirm", () => {
                if (sheetName === 'Project') {
                    state.rabs = state.rabs.filter(r => r.projectId !== id);
                    state.projects = state.projects.filter(x => x.id !== id);
                    if(state.photos) delete state.photos[id];
                } 
                else if (sheetName === 'Transaksi') {
                    const tx = state.transactions.find(x => x.id === id);
                    if(tx && tx.type === 'pemasukan' && tx.project) {
                        const pIdx = state.projects.findIndex(p => p.nama === tx.project);
                        if(pIdx !== -1) { state.projects[pIdx].terbayar = Math.max(0, (parseFloat(state.projects[pIdx].terbayar) || 0) - (parseFloat(tx.amount) || 0)); }
                    }
                    state.transactions = state.transactions.filter(x => x.id !== id);
                }
                else if (sheetName === 'Tukang') { 
                    state.workers = state.workers.filter(x => x.id !== id); 
                    if(document.getElementById('w-id').value === id) window.resetWorkerForm();
                }
                else if (sheetName === 'Gaji') { 
                    const p = state.payrolls.find(x => x.id === id);
                    if(p) {
                        if (p.absensiIds && p.absensiIds.length > 0) {
                            state.attendances.forEach(a => {
                                if (p.absensiIds.includes(a.id)) { a.status = 'Belum Dibayar'; }
                            });
                        } else {
                            const otherPayrolls = state.payrolls.filter(x => x.id !== id && x.workerId === p.workerId && (x.project||'').toLowerCase() === (p.project||'').toLowerCase());
                            if(otherPayrolls.length === 0) {
                                state.attendances.forEach(a => {
                                    if(a.workerId === p.workerId && (a.project||'').toLowerCase() === (p.project||'').toLowerCase() && a.status === 'Terekap di Gaji') {
                                        a.status = 'Belum Dibayar';
                                    }
                                });
                            }
                        }
                    }
                    state.payrolls = state.payrolls.filter(x => x.id !== id); 
                }
                else if (sheetName === 'Absensi') { state.attendances = state.attendances.filter(x => x.id !== id); }
                else if (sheetName === 'Rekap') { state.salaryRecaps = state.salaryRecaps.filter(x => x.id !== id); }
                
                fullSaveAndRefresh();
            });
        };

