                const margin = inTotal - outTotal;
                const marginPct = inTotal > 0 ? (margin / inTotal) * 100 : 0;

                let globalKasbon = 0;
                state.workers.forEach(w => {
                    let wTx = 0; let wUsed = 0;
                    state.transactions.forEach(t => { if(t.type === 'pengeluaran' && (t.category||'').toLowerCase()==='kasbon' && t.worker===w.nama) wTx += parseFloat(t.amount)||0; });
                    state.payrolls.forEach(p => { if(p.workerId === w.id) wUsed += parseFloat(p.kasbon)||0; });
                    globalKasbon += Math.max(0, wTx - wUsed);
                });
                
                let absensiCount = state.attendances.length;
                let unpaidAbsensi = state.attendances.filter(a => a.status === 'Belum Dibayar').length;

                let overbudgetProjects = [];
                let deficitProjects = [];
                
                state.projects.forEach(p => {
                    let pIn = 0; let pOut = 0; let pMat = 0; let pUpah = 0;
                    state.transactions.forEach(t => { 
                        if(t.project && t.project.toLowerCase() === (p.nama||'').toLowerCase()) { 
                            if(t.type === 'pemasukan') pIn += parseFloat(t.amount)||0; 
                            else {
                                pOut += parseFloat(t.amount)||0; 
                                if((t.category||'').toLowerCase() === 'material') pMat += parseFloat(t.amount)||0;
                                if((t.category||'').toLowerCase() === 'gaji') pUpah += parseFloat(t.amount)||0;
                            }
                        }
                    });
                    
                    if (pOut > pIn && pIn > 0) deficitProjects.push(p.nama);
                    
                    const bahanAlokasi = parseFloat(p.bahanAlokasi)||0;
                    const upahAlokasi = parseFloat(p.tukangAlokasi)||0;
                    
                    if ((bahanAlokasi > 0 && pMat > bahanAlokasi) || (upahAlokasi > 0 && pUpah > upahAlokasi)) {
                        overbudgetProjects.push(p.nama);
                    }
