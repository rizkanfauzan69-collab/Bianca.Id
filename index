                    if (deficitProjects.length > 0) reportHtml += `<li class="text-rose-400 font-medium">Project ${deficitProjects.join(', ')} mengalami defisit kas internal (Pengeluaran > Termin Masuk).</li>`;
                    reportHtml += `</ul></div>`;

                    reportHtml += `<div class="mb-3"><h6 class="text-[10px] font-bold text-amber-400 uppercase mb-1"><i class="fas fa-users"></i> Evaluasi SDM & Kedisiplinan</h6><ul class="list-disc pl-4 text-cream/80 space-y-1">`;
                    if (globalKasbon > 0) {
                        reportHtml += `<li>Dana tertahan di Kasbon Tukang sebesar <b class="text-rose-400">Rp ${formatRp(globalKasbon)}</b>. `;
                        if (globalKasbon > (margin * 0.2)) reportHtml += `<span class="text-rose-400 font-bold bg-rose-400/10 px-1 rounded block mt-1">⚠️ Melebihi 20% margin kas. Hentikan kasbon baru!</span>`;
                        reportHtml += `</li>`;
                    } else { reportHtml += `<li class="text-emerald-400">Sirkulasi kasbon sehat (Tidak ada tunggakan berlebih).</li>`; }
                    
                    if (unpaidAbsensi > 0) reportHtml += `<li>Masih ada <b>${unpaidAbsensi}</b> riwayat absensi yang belum digaji. Awas hutang numpuk.</li>`;
                    else reportHtml += `<li class="text-emerald-400">Pencatatan gaji sangat disiplin.</li>`;
                    reportHtml += `</ul></div>`;

