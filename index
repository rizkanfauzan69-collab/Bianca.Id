                        <p style="text-align: right; font-size: 10px; color: rgba(92, 64, 51, 0.6); text-transform: uppercase; letter-spacing: 1px;">
                            Dicetak pada: ${getRealTimeIndonesianDate()} | BIANCA.ID
                        </p>
                    </div>
                </div>
            `;

            window.showModal("Table Laporan Absensi", absensiHTML, 'alert');
            document.getElementById('custom-modal-buttons').innerHTML = `
