                                    <th style="padding: 8px; text-align: center; border: 1px solid rgba(197, 160, 89, 0.3); width: 30px;">No</th>
                                    <th style="padding: 8px; text-align: left; border: 1px solid rgba(197, 160, 89, 0.3); min-width: 120px;">Nama Tukang</th>
