            let tableRowsHtml = Object.values(workerData).map((w, i) => {
                let cells = sortedDates.map(d => {
                    let data = w.dates[d];
                    if (!data) return `<td style="padding: 6px; text-align: center; border: 1px solid rgba(197, 160, 89, 0.3); color: #C5A059;">-</td>`;
                    
                    let displayHari = data.hari;
                    if (data.hari === 1) displayHari = "Full";
                    else if (data.hari === 0.5) displayHari = "½";
                    
                    let text = `${displayHari}`;
                    if (data.jam > 0) text += `<br><span style="font-size:8px;color:#059669;font-weight:700;">+${data.jam} Jam</span>`;
                    return `<td style="padding: 6px; text-align: center; border: 1px solid rgba(197, 160, 89, 0.3); font-weight: 700; color: #120C08;">${text}</td>`;
