                return `
                    <tr style="border-bottom: 1px solid rgba(92, 64, 51, 0.2);">
                        <td style="padding: 6px; font-weight: 700; color: #120C08; border: 1px solid rgba(197, 160, 89, 0.3); text-align: center;">${i+1}</td>
                        <td style="padding: 6px; font-weight: 700; color: #120C08; border: 1px solid rgba(197, 160, 89, 0.3);">${w.name}</td>
                        ${cells}
                        <td style="padding: 6px; text-align: center; font-weight: 800; color: #120C08; border: 1px solid rgba(197, 160, 89, 0.3); background-color: rgba(197, 160, 89, 0.1);">${w.totalHari}</td>
