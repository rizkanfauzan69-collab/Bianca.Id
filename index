        window.runStaticAnalysis = function() {
            const btn = document.getElementById('btn-run-analysis'); const box = document.getElementById('ai-result-box'); const content = document.getElementById('ai-content');
            
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses Data...'; 
