        window.previewTableAbsensi = function() {
            const pName = document.getElementById('filter-abs-project').value;
            const startStr = document.getElementById('abs-hist-start').value;
            const endStr = document.getElementById('abs-hist-end').value;
            
            const cbElements = document.querySelectorAll('.abs-worker-cb');
            let allowedWorkerIds = [];
            cbElements.forEach(cb => { if (cb.checked) allowedWorkerIds.push(cb.value); });

            if (!pName || !startStr || !endStr) {
                window.showModal("Data Tidak Lengkap", "Pilih Project, Tanggal Mulai, dan Tanggal Akhir terlebih dahulu.", "alert");
                return;
            }

            const startParts = startStr.split('-');
            const endParts = endStr.split('-');
            const startD = new Date(parseInt(startParts[0]), parseInt(startParts[1]) - 1, parseInt(startParts[2]), 0, 0, 0);
            const endD = new Date(parseInt(endParts[0]), parseInt(endParts[1]) - 1, parseInt(endParts[2]), 23, 59, 59);

            let filteredAbs = [];
            let uniqueDates = new Set();
            state.attendances.forEach(a => {
                if (a.project.toLowerCase() === pName.toLowerCase()) {
                    if (allowedWorkerIds.length > 0 && !allowedWorkerIds.includes(a.workerId)) return;
                    
                    const aDateParts = a.date.split('/');
                    if(aDateParts.length === 3) {
                        const aDate = new Date(parseInt(aDateParts[2]), parseInt(aDateParts[1]) - 1, parseInt(aDateParts[0]), 12, 0, 0);
                        if (aDate >= startD && aDate <= endD) {
                            filteredAbs.push(a);
                            uniqueDates.add(a.date);
                        }
                    }
                }
            });

            if (filteredAbs.length === 0) {
                window.showModal("Tidak Ada Data", "Tidak ada absensi pada rentang tanggal tersebut untuk project yang dipilih.", "alert");
                return;
            }

            let sortedDates = Array.from(uniqueDates).sort((a,b) => {
                const pa = a.split('/'); const pb = b.split('/');
                return new Date(pa[2], pa[1]-1, pa[0]) - new Date(pb[2], pb[1]-1, pb[0]);
            });

            let workerData = {};
            filteredAbs.forEach(a => {
                if (!workerData[a.workerId]) {
                    workerData[a.workerId] = { name: a.workerName, dates: {}, totalHari: 0, totalJam: 0 };
                }
                if(!workerData[a.workerId].dates[a.date]) {
                     workerData[a.workerId].dates[a.date] = { hari: 0, jam: 0 };
                }
                workerData[a.workerId].dates[a.date].hari += (parseFloat(a.hari) || 0);
                workerData[a.workerId].dates[a.date].jam += (parseFloat(a.jam) || 0);
                workerData[a.workerId].totalHari += (parseFloat(a.hari) || 0);
                workerData[a.workerId].totalJam += (parseFloat(a.jam) || 0);
