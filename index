        window.calculateAutoAbsensi = function() {
            const wId = document.getElementById('payroll-worker-select').value; const pName = document.getElementById('payroll-project-select').value;
            if(!wId || !pName) {
                document.getElementById('p-hari-kerja').value = '0'; document.getElementById('p-jam-lembur').value = '0';
                document.getElementById('abs-hari-note').innerText = "Terkunci"; document.getElementById('abs-hari-note').className = "text-[9px] text-cream/30 px-1.5 rounded";
                document.getElementById('abs-jam-note').innerText = "Terkunci"; document.getElementById('abs-jam-note').className = "text-[9px] text-cream/30 px-1.5 rounded";
                return;
            }
            let totalHari = 0; let totalJam = 0;
            state.attendances.forEach(a => {
                if(a.workerId === wId && a.project.toLowerCase() === pName.toLowerCase() && a.status === 'Belum Dibayar') {
                    totalHari += parseFloat(a.hari) || 0; totalJam += parseFloat(a.jam) || 0;
                }
            });
            document.getElementById('p-hari-kerja').value = totalHari; document.getElementById('p-jam-lembur').value = totalJam;
            const txtStyle = "text-[9px] text-emerald-400 font-bold bg-emerald-400/10 px-1.5 py-0.5 rounded shadow-sm";
            document.getElementById('abs-hari-note').innerText = totalHari > 0 ? "Otomatis" : "Terkunci"; document.getElementById('abs-hari-note').className = totalHari > 0 ? txtStyle : "text-[9px] text-cream/30 px-1.5 rounded";
            document.getElementById('abs-jam-note').innerText = totalJam > 0 ? "Otomatis" : "Terkunci"; document.getElementById('abs-jam-note').className = totalJam > 0 ? txtStyle : "text-[9px] text-cream/30 px-1.5 rounded";
        };

        window.calculateAutoKasbon = function() {
            const wId = document.getElementById('payroll-worker-select').value; const pName = document.getElementById('payroll-project-select').value;
            const kasbonInput = document.getElementById('p-kasbon'); const note = document.getElementById('kasbon-note');
            if(!wId || !pName) { kasbonInput.value = '0'; note.innerText = "Terkunci"; note.className = "text-[9px] text-cream/30 px-1.5 rounded"; return; }

            const w = state.workers.find(x => x.id === wId); let totalKasbonTx = 0; let totalKasbonUsed = 0;
            
            state.transactions.forEach(t => {
                if(t.type === 'pengeluaran' && (t.category||'').toLowerCase() === 'kasbon') {
                    if(t.project && t.project.toLowerCase() === pName.toLowerCase()) {
                        if(t.worker && w.nama.toLowerCase() === t.worker.toLowerCase()) { 
                            totalKasbonTx += parseFloat(t.amount) || 0; 
                        }
                    }
                }
            });
            state.payrolls.forEach(p => { if(p.workerId === wId && p.project && p.project.toLowerCase() === pName.toLowerCase()) { totalKasbonUsed += parseFloat(p.kasbon) || 0; } });

            const sisaKasbon = Math.max(0, totalKasbonTx - totalKasbonUsed);
            let cicilanRencana = window.safeParseFloat(w.potonganKasbon) || 0;
            let finalPotong = sisaKasbon > 0 && cicilanRencana > 0 ? Math.min(sisaKasbon, cicilanRencana) : sisaKasbon;
            
            kasbonInput.value = finalPotong;
            note.innerText = sisaKasbon > 0 ? `Sisa: ${formatRp(sisaKasbon)}` : "Terkunci";
            note.className = sisaKasbon > 0 ? "text-[9px] text-rose-400 bg-rose-400/10 px-1.5 py-0.5 font-bold rounded shadow-sm" : "text-[9px] text-cream/30 px-1.5 rounded";
        };

        window.calculateAndSavePayroll = function() {
            const workerId = document.getElementById('payroll-worker-select').value; const projName = document.getElementById('payroll-project-select').value;
            const hari = parseFloat(document.getElementById('p-hari-kerja').value) || 0; const jam = parseFloat(document.getElementById('p-jam-lembur').value) || 0;
            const tambahan = parseFloat(document.getElementById('p-tambahan').value) || 0; const kasbon = parseFloat(document.getElementById('p-kasbon').value) || 0;
            
            if (!workerId || hari <= 0 || !projName) { window.showModal("Data Tidak Lengkap", "Pilih Project & Pekerja. Pastikan ada riwayat absensi minimal 0.5 hari.", "alert"); return; }

            const worker = state.workers.find(w => w.id === workerId);
            const kotor = (hari * worker.harian) + (jam * worker.lembur) + tambahan; const bersih = kotor - kasbon;
            
            const cleanD = cleanDate(getTodayDateInput());
            state.payrolls.push({ id: generateId(), workerId: worker.id, nama: worker.nama, jabatan: worker.jabatan, date: cleanD, hari, jam, tambahan, kasbon, kotor, bersih, status: 'Belum Dibayar', project: projName });
            
            state.attendances.forEach(a => {
                if(a.workerId === worker.id && a.project.toLowerCase() === projName.toLowerCase() && a.status === 'Belum Dibayar') { a.status = 'Terekap di Gaji'; }
            });

            fullSaveAndRefresh();
            document.getElementById('payroll-worker-select').value = ''; document.getElementById('p-hari-kerja').value = '0';
            document.getElementById('p-jam-lembur').value = '0'; document.getElementById('p-tambahan').value = ''; document.getElementById('p-kasbon').value = '0';
            window.showModal("Gaji Disimpan", `Slip gaji ${worker.nama} tercatat untuk proyek ${projName}.`, "alert");
        };

