                if (response.ok && resJson.candidates && resJson.candidates.length > 0) {
                    let text = resJson.candidates[0].content.parts[0].text;
                    text = text.replace(/\*\*(.*?)\*\*/g, '<strong class="text-sky-300">$1</strong>');
                    text = text.replace(/\*(.*?)\*/g, '<em class="text-cream/80">$1</em>');
                    text = text.replace(/\n/g, '<br>');
                    contentBox.innerHTML = text;
                } else {
                    let errDetail = resJson.error ? (resJson.error.message || resJson.error.status) : "Respon tidak valid";
                    throw new Error(errDetail);
                }
            } catch (e) {
                contentBox.innerHTML = `
                    <div class="text-rose-400 p-2 rounded bg-rose-900/20 border border-rose-500/30">
                        <p class="font-bold mb-1"><i class="fas fa-exclamation-circle"></i> Gagal terhubung ke API Gemini</p>
                        <p class="text-[10px] text-cream/80">${e.message || 'Periksa kembali API Key dan pastikan koneksi internet stabil.'}</p>
                    </div>
                `;
            }
            btn.innerHTML = '<i class="fas fa-paper-plane"></i> Tanyakan ke AI';
            btn.disabled = false;
        };
    </script>
</body>
