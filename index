                    if (globalKasbon > 0 && unpaidAbsensi > 0) reportHtml += `<p>• <b class="text-cream">Siklus Potong Kasbon:</b> Buka menu HR -> Cetak Gaji Mingguan. Bayarkan absensi yang tertunda agar sistem memotong sisa kasbon tukang secara otomatis.</p>`;
                    
                    if (margin > 0 && deficitProjects.length === 0 && overbudgetProjects.length === 0 && (globalKasbon < (inTotal * 0.1))) {
                        reportHtml += `<p>• <b class="text-emerald-400">Pertahankan Disiplin:</b> Arus kas dan proyek berjalan lancar. Pertimbangkan menyimpan minimal 20% dari margin saat ini untuk dana darurat perusahaan.</p>`;
